# Application Starter Template — production environment file (Scope §6.6,
# blueprint §38 environment separation).
#
# Copy this file to the deployment host as `$DEPLOY_ROOT/.env.production`
# (default $DEPLOY_ROOT = /opt/app-template), fill every value, and
# `chmod 600` it. This file IS the production secret store for the hybrid VPS
# profile: the API and worker containers read it directly
# (compose.hybrid-vps.yml `env_file`), and the deploy-vps.yml workflow runs
# `docker compose --env-file` against it. Keep an off-site backup of this
# file (SECURITY.md, docs/backup-and-recovery.md).
#
# Environment separation (BP §38): one of these files per environment
# (staging, production) with separate databases, Redis instances, storage
# buckets, WorkOS environments, secrets, and frontend/API URLs. Staging must
# never use production data or credentials. Do not commit this file; the
# committed `.env.example` carries only safe development placeholders.
#
# Host-level deployment inputs used by the workflow (registry, host, release
# path, domain) are GitHub variables/secrets or workflow inputs, not values
# the containers read; they are listed here only so the whole deployment
# surface is documented in one place.

# ---- Deployment inputs (GitHub variables/secrets, not container settings) --
# Image registry (default ghcr.io) and image refs (backend and Caddy edge)
# are derived from the repository name by deploy-vps.yml and passed to the
# host at deploy time, so the `.env.production` file never needs them on the
# workflow path. Set CADDY_IMAGE here only when overriding the derived ref or
# when running `docker compose up` manually on the host, where it must name a
# real image: the CI-published `<registry>/<org>/<app>-caddy:<sha>` ref, or an
# image built locally from the release checkout (`docker build deploy/caddy`).
# REGISTRY=ghcr.io
# CADDY_IMAGE=ghcr.io/<org>/<app>-caddy:<sha>
# DEPLOY_HOST=deploy@vps.example.com
# RELEASE_DIR=/opt/app-template
# DOMAIN=app.example.com

# ---- Backend (app.core.config.Settings) -----------------------------------
APP_NAME=app-template
APP_ENV=production          # production; forces DEBUG=false and fails fast on
                            # missing SMTP configuration or EMAIL_PROVIDER=fake
DEBUG=false
LOG_LEVEL=INFO

# Managed PostgreSQL (external service; never the VPS disk). Use a dedicated
# least-privilege role; the full connection string is a secret and is on the
# BP §28 never-log list.
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@db.example.com:5432/app_template_production

# Private Redis run by this profile (compose.hybrid-vps.yml). Not published
# beyond the compose network; the password here must match REDIS_PASSWORD in
# the compose file (used by the server itself). Used for the Dramatiq broker
# and the distributed API rate limit. REDIS_URL must carry the same password
# explicitly (env files are not variable-expanded). Plain `redis://` is
# allowed here because Redis is unreachable from the public network; any
# externally reachable Redis must use `rediss://` (config.py fails fast).
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@redis:6379/0

# ---- Edge (Caddy) ----------------------------------------------------------
# Contact email Let's Encrypt registers for the ACME account (renewal-failure
# notices reach this address). Required: the compose file fails fast when
# unset (like REDIS_PASSWORD) because an empty value breaks Caddy config
# adaptation (docs/backup-and-recovery.md run B, defect D2).
ACME_EMAIL=ops@example.com

# ---- WorkOS ----------------------------------------------------------------
# Production WorkOS environment credentials. WorkOS environments are
# separated per environment (BP §38): staging and production each have their
# own app, API key, client id and webhook secret.
WORKOS_API_KEY=CHANGE_ME
WORKOS_CLIENT_ID=CHANGE_ME
WORKOS_API_BASE_URL=https://api.workos.com/
# The exact issuer of validated access tokens for this WorkOS application;
# read it from a real token's public `iss` claim.
WORKOS_JWT_ISSUER=https://api.workos.com/
WORKOS_JWT_LEEWAY=30
# Email the one-time platform bootstrap grants platform_admin to. Leave empty
# once the first platform admin exists.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
# WorkOS webhook endpoint secret (must match the dashboard). Fail-closed when
# empty: every webhook delivery is rejected.
WORKOS_WEBHOOK_SECRET=CHANGE_ME

# Exact browser origins. Production values must be the real HTTPS origins
# (the same-origin Caddy proxy covers the app itself; add any other origin
# that calls the API directly).
CORS_ALLOWED_ORIGINS='["https://app.example.com"]'
# Exact Host headers the API accepts — the production domain(s) only.
TRUSTED_HOSTS='["app.example.com"]'

# ---- Object storage --------------------------------------------------------
# S3-compatible object storage (external service: AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, or a self-hosted S3 service). The bucket
# is private; the browser uploads/downloads through short-lived signed URLs.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=app-template-production
STORAGE_ENDPOINT_URL=https://s3.example-provider.com
# Leave empty unless the browser must reach the storage host through a
# different URL than the API uses (defaults to STORAGE_ENDPOINT_URL).
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_MAX_UPLOAD_SIZE=26214400
STORAGE_ALLOWED_CONTENT_TYPES='["application/pdf","application/json","text/plain","text/csv","image/png","image/jpeg"]'

# ---- Email / SMTP ----------------------------------------------------------
# Production requires EMAIL_PROVIDER=smtp with explicit SMTP_HOST, SMTP_PORT
# and EMAIL_FROM (fail-fast). Point these at the transactional provider's
# SMTP relay (Postmark, SES, SendGrid, Resend); SMTP credentials are secrets.
# Email is always sent from the Dramatiq worker, never from an HTTP handler.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@app.example.com
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Use STARTTLS for port 587 relays. Use SMTP_PORT=465 with SMTP_USE_TLS=false
# for implicit-TLS relays (the SMTP adapter handles SMTPS separately).
SMTP_USE_TLS=true

# ---- Observability: Sentry ------------------------------------------------
# Set the DSN to capture errors (recommended in production). Empty boots the
# app without the SDK. SENTRY_ENVIRONMENT defaults to APP_ENV; set it
# explicitly when routing alerts per environment.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Worker ----------------------------------------------------------------
# Dramatiq threads per worker process. Compose runs one worker container with
# this concurrency; scale horizontally with `docker compose up -d --scale
# worker=N` (docs/operations.md). The documented default is 8.
WORKER_CONCURRENCY=8

# ---- AI / LLM layer (v0.7 Scope §6.3/§6.7, ADR-0017/ADR-0018) --------------
# Enable exactly the providers this deployment is approved to use and inject
# their secrets through this file (chmod 600) or a secret store; secrets must
# never reach the API, frontend, logs, Sentry or audit metadata. The fake
# provider is REJECTED in production (fail-fast). Enabling a provider without
# its required configuration also fails fast at startup. Regional/inference-
# geography settings are validated: unsupported values fail configuration
# validation, and routing never changes a provider's region implicitly.
#
# The template ships one demonstration task (`document.classify`), which
# requires the `documents` capability. Enable the provider(s) whose models the
# checked-in model registry declares for it: OpenAI (gpt-4o-mini), Azure
# OpenAI (gpt-4o-mini), Anthropic (claude-sonnet-4-6) and Vertex Gemini
# (gemini-2.0-flash) all declare `documents`, so any one of them (or the fake
# provider, test/default only — REJECTED in production) can serve the demo
# end to end. DeepSeek and the local OpenAI-compatible model do not declare
# `documents`, so they cannot serve this task. See README → AI layer,
# docs/operations.md → AI observability, and SECURITY.md → AI security for the
# runbooks.
AI_ENABLED_PROVIDERS='["openai"]'
AI_HTTP_TIMEOUT_SECONDS=60

# ---- Large-file transfer modes (v0.8 Scope §2.2) ----------------------------
# Non-inline transfer modes are default-deny: leave this empty to deploy the
# inline path only. Enable a mode only after configuring its provider and
# private staging infrastructure — production fails fast on an enabled mode
# without the supporting provider/configuration. Above the 5,000,000-byte
# aggregate inline threshold exactly one PDF (max 50,000,000 bytes) may use a
# non-inline mode: `provider_upload` (OpenAI/Anthropic transient sources),
# `managed_signed_url` (retained private S3 sources) or `storage_reference`
# (Vertex, via AI_VERTEX_TEMP_GCS_BUCKET). Azure OpenAI, DeepSeek and local
# providers declare no non-inline mode and reject large files before any
# transfer. Managed signed URLs are minted just-in-time per dispatch with a
# short TTL (default 900 s, max 1,800 s) and are never returned, persisted,
# audited or logged; caller-supplied HTTP(S) URLs are always prohibited.
#   AI_ENABLED_TRANSFER_MODES='[]'
#   AI_INLINE_AGGREGATE_THRESHOLD_BYTES=5000000
#   AI_MAX_LARGE_ATTACHMENT_BYTES=50000000
#   AI_UPLOAD_EXPIRY_SECONDS=3600
#   AI_MANAGED_URL_TTL_SECONDS=900
#   AI_RECONCILE_BATCH_SIZE=50
#   AI_RECONCILE_RETRY_AFTER_SECONDS=3600
AI_ENABLED_TRANSFER_MODES='[]'

# OpenAI (server-side secret; region 'us'/'eu' are approved-account
# data-residency opt-ins — leave empty for the provider default).
AI_OPENAI_API_KEY=CHANGE_ME
AI_OPENAI_BASE_URL=
AI_OPENAI_REGION=

# Anthropic (server-side secret; 'us' = US-only inference, Claude 4.6+ only).
AI_ANTHROPIC_API_KEY=CHANGE_ME
AI_ANTHROPIC_BASE_URL=
AI_ANTHROPIC_INFERENCE_GEOGRAPHY=

# DeepSeek (server-side secret; no template-controlled regional pinning).
AI_DEEPSEEK_API_KEY=CHANGE_ME
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Azure OpenAI (server-side secret; region inherent in the endpoint; the
# registry model field names the deployment).
AI_AZURE_OPENAI_API_KEY=CHANGE_ME
AI_AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
AI_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Vertex AI (ADR-0018): Gemini through Vertex AI only — no Gemini
# Developer API key. Project + explicit data-residency location are required
# when this adapter is enabled; credentials come from Application Default
# Credentials (workload identity) or a service-account key mounted through the
# deployment secret mechanism (AI_VERTEX_CREDENTIALS_PATH, server-side only).
# For the `storage_reference` transfer mode, AI_VERTEX_TEMP_GCS_BUCKET names a
# user-provisioned private, single-region, same-location bucket. The workload
# identity needs more than an object role: the adapter verifies project
# ownership, bucket metadata and the bucket IAM policy before any upload, so
# grant roles/storage.objectAdmin (or objectUser) plus roles/viewer, or a
# custom role with resourcemanager.projects.get, storage.buckets.get,
# storage.buckets.getIamPolicy, storage.objects.create, storage.objects.get,
# storage.objects.delete. The application never creates/configures/manages the
# bucket and runs no scheduled GCS cleanup; it deletes only the exact AI-owned
# staging object it uploaded (best-effort terminal deletion). Configure a
# console Object Lifecycle rule (`age = 1` day -> Delete) as the asynchronous
# cleanup backstop; soft delete/versioning/retention holds on the bucket extend
# object retention/recoverability rather than guaranteeing that a live object
# persists (v0.8 Scope §2.4/§2.5).
AI_VERTEX_PROJECT=
AI_VERTEX_LOCATION=
AI_VERTEX_CREDENTIALS_PATH=
AI_VERTEX_TEMP_GCS_BUCKET=

# Local OpenAI-compatible endpoint (Ollama/vLLM/SGLang): must be loopback or a
# private host — production rejects publicly reachable endpoints, and it must
# never be exposed to browsers.
AI_LOCAL_BASE_URL=
AI_LOCAL_API_KEY=

# Application Starter Template — environment variables (v0.2)
#
# Copy this file to `.env` and adjust. Every variable the application reads is
# documented here; the Compose file reads the POSTGRES_* variables and uses the
# same defaults, so the values below work out of the box with `make dev`.
#
# Host toolchain required for `make dev` (ADR-0008 — native app code,
# containerised infrastructure): Python 3.13 + `uv`, Node >= 24 + `pnpm`, and
# Docker with Compose for PostgreSQL/Redis. See the README clean-clone
# procedure.

# ---- Backend (app.core.config.Settings) -----------------------------------
APP_NAME=app-template
APP_ENV=development   # development | production; production forces DEBUG=false
DEBUG=false           # true enables readable non-JSON logs
LOG_LEVEL=INFO        # structlog level for the backend

# Async SQLAlchemy URL used by the backend and Alembic migrations. Under
# `make dev` the host-native API reaches the containerised PostgreSQL on
# localhost; the `make dev-docker` api container uses the same credentials via
# the postgres service hostname.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Redis is used for a distributed API rate limit. Use a TLS `rediss://` URL in
# production; `make dev` exposes the container at the local default below.
REDIS_URL=redis://localhost:6379/0

# ---- WorkOS (app.core.config.Settings) ------------------------------------
# Required in the production environment (fail-fast otherwise). The API key is
# a secret and must never be exposed to the frontend; the client id is public
# and doubles as the session-token audience. WORKOS_API_BASE_URL defaults to
# the WorkOS production API; point it at the staging URL in non-production
# environments. WORKOS_JWT_LEEWAY is the clock-skew tolerance (seconds) for
# session-token expiry validation.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_API_BASE_URL=https://api.workos.com/
# Exact WorkOS access-token issuer. In a multi-Application environment this
# is the AuthKit URL containing the environment default application's client ID.
# Read it from a validated token's public `iss` claim or WorkOS session details.
WORKOS_JWT_ISSUER=https://api.workos.com/
WORKOS_JWT_LEEWAY=30

# Email of the user the one-time platform bootstrap grants the platform_admin
# role to (Scope §6.4). The grant happens on that user's first login with a
# verified WorkOS email, is written to the `bootstrap_state` table, and can
# never happen twice. Leave empty to disable the bootstrap; unset it after the
# first platform admin is bootstrapped. Backend-only, never a frontend setting.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=

# Exact browser origins permitted to call the backend directly. Keep this as
# a JSON array (not a wildcard); same-origin proxy deployments can retain the
# local default, while production values must use HTTPS.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Exact Host request headers accepted by the API. Use the real public API
# hostname(s) in production; wildcard hosts are intentionally rejected.
TRUSTED_HOSTS=["localhost","127.0.0.1","test"]

# ---- Frontend (Vite) -------------------------------------------------------
# Base URL for the generated OpenAPI client. Empty (default) means same-origin,
# which is correct for local development (Vite dev proxy / nginx) and most
# deployments; set it only when the API is served from another origin.
VITE_API_BASE_URL=

# Public WorkOS client id used by the browser AuthKit flow (frontend/src/
# features/auth/workos.ts). It is not a secret; it must match the client id of
# the WorkOS application, which is also the audience the backend validates
# session tokens against (WORKOS_CLIENT_ID). The login page fails fast with a
# clear message when it is unset.
VITE_WORKOS_CLIENT_ID=

# Optional override for the AuthKit callback URL. Defaults to
# <origin>/auth/callback, the frontend route that completes the login flow;
# the same URL must be registered as a Redirect URI in the WorkOS dashboard.
VITE_WORKOS_REDIRECT_URI=

# ---- Infrastructure (deploy/compose/compose.local.yml) ---------------------
# Credentials for the containerised PostgreSQL. Keep in sync with DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host ports for the containerised services. Change these if the defaults are
# already taken on your machine (e.g. REDIS_PORT=6380 when a local Redis runs
# on 6379). Remember to adjust DATABASE_URL accordingly if POSTGRES_PORT moves.
POSTGRES_PORT=5432
REDIS_PORT=6379

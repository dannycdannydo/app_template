# Application Starter Template — environment variables (v0.5)
#
# Copy this file to `.env` and adjust. Every variable the application reads is
# documented here; the Compose file reads the POSTGRES_* variables and uses the
# same defaults, so the values below work out of the box with `make dev`.
#
# Host toolchain required for `make dev` (ADR-0008 — native app code,
# containerised infrastructure): Python 3.13 + `uv`, Node >= 24 + `pnpm`, and
# Docker with Compose for PostgreSQL/Redis. See the README clean-clone
# procedure.

# ---- Backend (app.core.config.Settings) -----------------------------------
APP_NAME=app-template
APP_ENV=development   # development | production; production forces DEBUG=false
DEBUG=false           # true enables readable non-JSON logs
LOG_LEVEL=INFO        # structlog level for the backend

# Async SQLAlchemy URL used by the backend and Alembic migrations. Under
# `make dev` the host-native API reaches the containerised PostgreSQL on
# localhost; the `make dev-docker` api container uses the same credentials via
# the postgres service hostname.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Redis is used for a distributed API rate limit. Production requires TLS
# (`rediss://`) for any externally reachable Redis; the hybrid VPS profile's
# private compose-network Redis (never published) legitimately uses plain
# `redis://`. `make dev` exposes the container at the local default below.
REDIS_URL=redis://localhost:6379/0

# ---- WorkOS (app.core.config.Settings) ------------------------------------
# Required in the production environment (fail-fast otherwise). The API key is
# a secret and must never be exposed to the frontend; the client id is public
# and doubles as the session-token audience. WORKOS_API_BASE_URL defaults to
# the WorkOS production API; point it at the staging URL in non-production
# environments. WORKOS_JWT_LEEWAY is the clock-skew tolerance (seconds) for
# session-token expiry validation.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_API_BASE_URL=https://api.workos.com/
# Exact WorkOS access-token issuer. In a multi-Application environment this
# is the AuthKit URL containing the environment default application's client ID.
# Read it from a validated token's public `iss` claim or WorkOS session details.
WORKOS_JWT_ISSUER=https://api.workos.com/
WORKOS_JWT_LEEWAY=30

# Email of the user the one-time platform bootstrap grants the platform_admin
# role to (Scope §6.4). The grant happens on that user's first login with a
# verified WorkOS email, is written to the `bootstrap_states` table, and can
# never happen twice. Leave empty to disable the bootstrap; unset it after the
# first platform admin is bootstrapped. Backend-only, never a frontend setting.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=

# Password for the bootstrap platform admin account. Used only by
# `make provision-admin`, which pre-creates the WorkOS user (email + password,
# verified email) when signups are disabled, so the operator can log in with
# this password right away. Never shown in logs; the WorkOS password policy
# and blocklist still apply. Backend-only, never a frontend setting.
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=

# Name of the organisation the one-time platform bootstrap also creates and
# makes the bootstrap admin an owner of, so the default admin is never left
# without an organisation (org-scoped screens otherwise stay pending forever).
# Leave empty to skip org creation. Backend-only, never a frontend setting.
BOOTSTRAP_PLATFORM_ADMIN_ORG=

# WorkOS webhook endpoint secret used to verify the signature of inbound
# webhook deliveries (Scope §6.8). Must match the endpoint secret configured in
# the WorkOS dashboard. Leave empty to disable webhook processing: the endpoint
# then rejects every delivery (fail-closed), and login-time invitation
# reconciliation stays authoritative. Backend-only, never a frontend setting.
WORKOS_WEBHOOK_SECRET=

# Exact browser origins permitted to call the backend directly. Keep this as
# a JSON array (not a wildcard); same-origin proxy deployments can retain the
# local default, while production values must use HTTPS.
CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'

# Exact Host request headers accepted by the API. Use the real public API
# hostname(s) in production; wildcard hosts are intentionally rejected.
TRUSTED_HOSTS='["localhost","127.0.0.1","test"]'

# ---- Object storage (app.core.config.Settings, Scope §6.1) -----------------
# Provider-neutral storage (ADR-0006): 's3' selects the S3-compatible adapter,
# 'fake' an in-memory implementation used by the test suite only. Production
# must be 's3' with explicit credentials/bucket/endpoint; the values below are
# the MinIO-friendly development defaults (`make dev` starts MinIO at 9000).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=app-files
STORAGE_ENDPOINT_URL=http://localhost:9000
# Endpoint used when presigning URLs where the browser cannot reach the API's
# storage host (e.g. the dev-docker stack); defaults to STORAGE_ENDPOINT_URL.
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# Maximum accepted upload size in bytes (default 25 MiB) and the allowed MIME
# types, enforced at upload-intent time (blueprint §30). Both are backend-only;
# never expose storage credentials to the frontend.
STORAGE_MAX_UPLOAD_SIZE=26214400
STORAGE_ALLOWED_CONTENT_TYPES='["application/pdf","application/json","text/plain","text/csv","image/png","image/jpeg"]'

# ---- Frontend (Vite) -------------------------------------------------------
# Base URL for the generated OpenAPI client. Empty (default) means same-origin,
# which is correct for local development (Vite dev proxy / nginx) and most
# deployments; set it only when the API is served from another origin.
VITE_API_BASE_URL=

# Public WorkOS client id used by the browser AuthKit flow (frontend/src/
# features/auth/workos.ts). It is not a secret; it must match the client id of
# the WorkOS application, which is also the audience the backend validates
# session tokens against (WORKOS_CLIENT_ID). The login page fails fast with a
# clear message when it is unset.
VITE_WORKOS_CLIENT_ID=

# Optional override for the AuthKit callback URL. Defaults to
# <origin>/auth/callback, the frontend route that completes the login flow;
# the same URL must be registered as a Redirect URI in the WorkOS dashboard.
VITE_WORKOS_REDIRECT_URI=

# ---- Local development overrides -------------------------------------------
# Set to true only when a local VPN exports an incompatible proxy URL (for
# example socks://...). `make dev` then removes proxy variables from the
# native API, worker and frontend processes. This is consumed only by
# scripts/dev.sh and is not an application or production setting.
DEV_DISABLE_PROXY=false

# ---- Infrastructure (deploy/compose/compose.local.yml) ---------------------
# Credentials for the containerised PostgreSQL. Keep in sync with DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host ports for the containerised services. Change these if the defaults are
# already taken on your machine (e.g. REDIS_PORT=6380 when a local Redis runs
# on 6379). Remember to adjust DATABASE_URL accordingly if POSTGRES_PORT moves.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Host ports for the containerised MinIO (object storage, Scope §6.2): the S3
# API is published on MINIO_PORT (9000) and the admin console on
# MINIO_CONSOLE_PORT (9001). The host-native `make dev` path reaches MinIO at
# http://localhost:9000, so STORAGE_ENDPOINT_URL above must match MINIO_PORT.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host ports for the containerised Mailhog (local email catcher, Scope §6.2):
# the SMTP port the SMTP_* settings above must point at, and the web UI that
# shows every message the worker sends.
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Root credentials for the containerised MinIO. Keep in sync with the
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY values above; both default
# to minioadmin for local development and must be changed in any shared
# environment. These are secrets — never expose them to the frontend.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Worker (app.workers, Scope §6.2) --------------------------------------
# Number of Dramatiq worker threads in the single worker process used by each
# local worker command/container (blueprint §18: worker concurrency must be
# configurable). Production scales worker containers rather than relying on
# Dramatiq's CPU-count process default. `make worker` and the dev-docker worker
# service pass this to the Dramatiq CLI; it is also available as
# worker_concurrency in app.core.config.Settings.
WORKER_CONCURRENCY=8

# Durable job execution bounds (durable delivery plan P2): JOB_TASK_TIME_LIMIT_MS
# is the standard Dramatiq actor time limit in milliseconds (600,000 ms = 10
# minutes), and JOB_EXECUTION_LEASE_SECONDS is how long a worker may own one job
# attempt in the `jobs` table before a stale/duplicate may take it over (900
# seconds = 15 minutes). The lease must exceed the time limit by at least 60
# seconds so a worker killed by the time limit can never be taken over before
# it actually stops; startup validation enforces the relationship. Progress
# updates renew the lease, so long document work keeps ownership as long as it
# is making progress. Both are also available as job_task_time_limit_ms and
# job_execution_lease_seconds in app.core.config.Settings.
JOB_TASK_TIME_LIMIT_MS=600000
JOB_EXECUTION_LEASE_SECONDS=900

# ---- Observability: Sentry (blueprint §28, Scope §6.1) ---------------------
# Error tracking. SENTRY_DSN is optional: when empty the application boots
# without initialising the SDK and nothing is captured; production deployments
# should set it (the deploy documentation recommends it). The DSN is a secret
# and must never be exposed to the frontend.
SENTRY_DSN=
# Environment label attached to captured events. Defaults to APP_ENV when
# empty; use distinct values per environment (e.g. staging vs production) so
# alerts can be routed and filtered.
SENTRY_ENVIRONMENT=
# Performance-trace sampling rate, a float between 0.0 and 1.0 (default 0.1).
# 0.0 disables performance traces entirely; raise it only when you need the
# sampling overhead it implies.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Email (app.core.config.Settings, Scope §6.2, ADR-0015) ----------------
# Provider-neutral email: 'smtp' selects the standard-library SMTP adapter
# (the default), 'fake' an in-memory implementation used by the test suite
# only. Production must be 'smtp' with explicit SMTP_HOST/SMTP_PORT/EMAIL_FROM
# (fail-fast otherwise). Application email is always sent from the Dramatiq
# worker, never from an HTTP handler.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
# SMTP relay. The values below are the Mailhog-friendly development defaults:
# `make dev` starts Mailhog, which accepts mail on 1025 without auth and shows
# it in the UI on 8025. Point these at a transactional provider's SMTP relay
# in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Enable STARTTLS for the SMTP relay; leave off for local Mailhog.
SMTP_USE_TLS=false

# ---- AI / LLM layer (v0.7 Scope §6.3, ADR-0017/ADR-0018) -------------------
# The AI layer is provider-neutral: application code calls AIService by task
# name (the template ships one demonstration task, `document.classify`) and
# never names a provider or model. These settings control provider
# *enablement* and endpoint/project/deployment *identifiers* only; API keys,
# Azure credentials and Google credential material are server-side secrets and
# must never reach the API, frontend, logs, Sentry or audit metadata.
#
# The deterministic fake adapter is the test default and is rejected in the
# production environment. `make dev` works with zero AI configuration beyond
# the default below; enabling a real provider requires its secret plus, for
# Vertex, Google Cloud identity configuration (see README → AI layer and
# docs/operations.md → AI observability).
#
# Enabled AI provider adapters, from: fake, openai, anthropic, deepseek,
# azure_openai, vertex, local. An empty list is allowed (the app boots with no
# AI provider; requests then fail fast with a clear configuration error).
AI_ENABLED_PROVIDERS='["fake"]'
# Per-request timeout for every AI provider adapter (seconds, 1-600).
AI_HTTP_TIMEOUT_SECONDS=60
# Non-inline transfer modes are default-deny; enable only after configuring
# the corresponding provider and private staging infrastructure.
AI_ENABLED_TRANSFER_MODES='[]'
# Local-development example — offline MinIO with the managed-signed-url GCS
# staging workaround (v0.8 Scope §2.3/§6.5): a local storage seam presigns
# plain-HTTP URLs the minter refuses and a cloud provider could not reach, so
# the AI layer stages the verified retained source into the private GCS temp
# bucket and mints a provider-fetchable GCS v4 HTTPS URL. To opt in, uncomment
# and complete this block (provider secret + Google identity, see README → AI
# layer):
# AI_ENABLED_PROVIDERS='["openai"]'
# AI_OPENAI_API_KEY=
# AI_ENABLED_TRANSFER_MODES='["managed_signed_url"]'
# AI_VERTEX_PROJECT=
# AI_VERTEX_LOCATION=europe-west1
# AI_VERTEX_TEMP_GCS_BUCKET=
# AI_VERTEX_CREDENTIALS_PATH=
AI_INLINE_AGGREGATE_THRESHOLD_BYTES=5000000
AI_MAX_LARGE_ATTACHMENT_BYTES=50000000
AI_UPLOAD_EXPIRY_SECONDS=3600
AI_MANAGED_URL_TTL_SECONDS=900
# Bounded batch of provider-file references the scheduled reconciliation sweep
# (v0.8 Scope §6.7) claims per run, and the minimum backoff before a reference
# whose terminal deletion failed is retried. The sweep is the only scheduled
# job that touches provider-hosted files; it never processes managed URLs, GCS
# staging objects or feature-owned sources (Scope §2.5).
AI_RECONCILE_BATCH_SIZE=50
AI_RECONCILE_RETRY_AFTER_SECONDS=3600

# ---- OpenAI adapter ---------------------------------------------------------
# API key (server-side secret, backend-only). Requires a paid OpenAI account.
AI_OPENAI_API_KEY=
# Optional OpenAI-compatible base URL override; empty uses
# https://api.openai.com/v1. An explicit value must name the same domain as
# the region-derived endpoint when AI_OPENAI_REGION is set.
AI_OPENAI_BASE_URL=
# Validated OpenAI data-processing region: 'us' or 'eu' (approved-account
# data-residency opt-ins) or empty for the provider default. A set region
# derives the regional endpoint (us.api.openai.com / eu.api.openai.com) and is
# recorded in routing metadata; fallback never changes it implicitly. Unsupported
# values fail configuration validation.
AI_OPENAI_REGION=

# ---- Anthropic adapter ------------------------------------------------------
# API key (server-side secret, backend-only).
AI_ANTHROPIC_API_KEY=
# Optional Anthropic base URL override; empty uses https://api.anthropic.com.
AI_ANTHROPIC_BASE_URL=
# Validated inference geography: 'global' (provider default) or 'us' (US-only
# inference; sent as inference_geo on POST /v1/messages, which only Claude 4.6+
# models accept). Empty or 'global' is the honest default for ordinary
# accounts; recorded in routing metadata; fallback never changes it implicitly.
AI_ANTHROPIC_INFERENCE_GEOGRAPHY=

# ---- DeepSeek adapter -------------------------------------------------------
# API key (server-side secret, backend-only). DeepSeek offers no
# template-controlled regional pinning; its inference location is the
# provider's, and routing metadata records no region for it.
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Azure OpenAI adapter ---------------------------------------------------
# Resource key (server-side secret, backend-only) and resource endpoint. The
# region is inherent in the configured endpoint; the model registry's model
# field names the deployment, so both must be set for the adapter to work.
AI_AZURE_OPENAI_API_KEY=
AI_AZURE_OPENAI_ENDPOINT=
# Pinned Azure OpenAI api-version query parameter (reviewed configuration).
AI_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---- Google Vertex AI adapter (Gemini; ADR-0018) ---------------------------
# Gemini is reached through the Vertex AI API only — there is no Gemini
# Developer API / Google AI Studio key path. Authentication uses Google Cloud
# Application Default Credentials or a service-account key supplied through
# the deployment secret mechanism (never a Gemini API key).
AI_VERTEX_PROJECT=
# Vertex AI location, e.g. europe-west1; explicit so deployments pin a
# data-residency region.
AI_VERTEX_LOCATION=
# Optional path to a service-account key JSON injected via the deployment
# secret mechanism; empty uses Application Default Credentials (workload
# identity on Google Cloud, gcloud ADC locally).
AI_VERTEX_CREDENTIALS_PATH=
# User-provisioned private, same-region bucket for Vertex large-file staging.
# The bucket must be non-public, single-region, in AI_VERTEX_LOCATION, and
# owned by AI_VERTEX_PROJECT. The service-account/workload identity needs more
# than an object role: before any upload the adapter verifies project
# ownership, bucket metadata and the bucket IAM policy, so it also requires
# resourcemanager.projects.get, storage.buckets.get and
# storage.buckets.getIamPolicy. Grant roles/storage.objectAdmin (or objectUser)
# plus roles/viewer on the bucket, or a custom role with all six permissions
# (resourcemanager.projects.get, storage.buckets.get,
# storage.buckets.getIamPolicy, storage.objects.create, storage.objects.get,
# storage.objects.delete). The application never creates, configures or
# manages the bucket and runs no scheduled GCS cleanup; it deletes only the
# exact AI-owned staging object it uploaded (best-effort terminal deletion).
# The deployer configures a console Object Lifecycle rule (`age = 1` day ->
# Delete) as the cleanup backstop, and lifecycle execution is asynchronous,
# not an exact 24-hour deletion guarantee. Soft delete, versioning or
# retention/holds extend object retention/recoverability rather than
# guaranteeing that a live object persists (Scope §2.4/§2.5).
AI_VERTEX_TEMP_GCS_BUCKET=

# ---- Local OpenAI-compatible adapter ----------------------------------------
# A private OpenAI-compatible endpoint (Ollama, vLLM or SGLang), e.g.
# http://127.0.0.1:11434/v1. http is allowed only for loopback/private hosts;
# the endpoint must never be exposed to browsers, and the production
# environment rejects publicly reachable endpoints (fail-fast).
AI_LOCAL_BASE_URL=
# Optional API key for the private local provider (vLLM deployments).
AI_LOCAL_API_KEY=

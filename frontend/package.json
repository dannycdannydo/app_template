    "@vueuse/core": "14.4.0",
    "@workos-inc/authkit-js": "0.20.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.2",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "3.5.40",
